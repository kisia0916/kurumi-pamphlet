// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum FoodStatus {
  AVAILABLE
  FEW
  SOLDOUT
}
enum FoodCategory {
  MAIN
  SUB
  DESSERT
}
model FoodData {
  id         String    @id @default(uuid())
  createdAt  DateTime @default(now())
  name       String
  category   FoodCategory
  photo      String
  price      Int
  status     FoodStatus
  allergens  String[]
}

model TimeTableContents {
  id        String    @id @default(uuid())
  createdAt DateTime @default(now())
  title     String
  place     String
  time      DateTime
  info      String
  photo     String
}

model StampPlace {
  id        String    @id @default(uuid())
  createdAt DateTime @default(now())
  title     String
  photo     String
  maplink   String
  place     String
}

model UserStamps {
  id         String    @id @default(uuid())
  createdAt  DateTime @default(now())
  userId     String
  stamps     String[]
  exchanged  Boolean
}

model User {
  id        String    @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
}

enum BuildingStatus {
  hard
  middle
  empty
}

model Buildings {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  name      String
  status    BuildingStatus
  picture   String
  floors    Floor[]
  projects  Projects[]
  mapPins   MapPin[]
}

model Floor {
  id          String      @id @default(uuid())
  createdAt   DateTime   @default(now())
  building    Buildings  @relation(fields: [building_id], references: [id])
  building_id String
  floor_num   Int
  projects    Projects[]
}

model Projects {
  id          String     @id @default(uuid())
  createdAt   DateTime  @default(now())
  name        String
  tag         String[]
  picture     String
  floor       Floor     @relation(fields: [floor_id], references: [id])
  floor_id    String
  building    Buildings @relation(fields: [building_id], references: [id])
  building_id String
  mapPins     MapPin[]
}

enum PinType {
  Building
  Room
}

model MapPin {
  id          String     @id @default(uuid())
  createdAt   DateTime  @default(now())
  type        PinType
  x           Int
  y           Int
  
  // リレーション - タイプに応じて参照するIDが異なる
  building_id String?
  project_id  String?
  
  // リレーション定義
  building    Buildings? @relation(fields: [building_id], references: [id])
  project     Projects?  @relation(fields: [project_id], references: [id])
}