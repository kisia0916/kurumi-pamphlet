// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum FoodStatus {
  AVAILABLE
  FEW
  SOLDOUT
}
enum FoodCategory {
  MAIN
  SUB
  DESSERT
}

enum ProjectGenre {
  SHOP
  STUDENT
  DISPLAY_CHEMISTRY
  DISPLAY_CULTURE
  PERFORMANCE
  MUSIC
  FOOD
  ACTIVITY
}

model FoodData {
  id         String    @id @default(uuid())
  createdAt  DateTime @default(now())
  name       String
  category   FoodCategory
  photo      String
  price      Int
  status     FoodStatus
  allergens  String[]
  food_place_id String
  food_pace       FoodPlace?     @relation(fields: [food_place_id], references: [id])
  food_index      Int?
}

model TimeTableContents {
  id        String    @id @default(uuid())
  createdAt DateTime @default(now())
  title     String
  place     String
  time      DateTime
  info      String
  photo     String
}

model StampPlace {
  id        String    @id @default(uuid())
  index    Int
  createdAt DateTime @default(now())
  title     String
  photo     String
  project_id String?
  description String
  project    Projects? @relation(fields: [project_id], references: [id])
  // User の押印履歴（逆参照）
  userStamps UserStamps[]
  // クイズ（逆参照）
  stampQuizzes StampQuiz[]
}

model UserStamps {
  id         String    @id @default(uuid())
  createdAt  DateTime @default(now())
  userId     String
  stampPlaceId String
  stamp        StampPlace @relation(fields: [stampPlaceId], references: [id])
}

model User {
  id        String    @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
}

enum BuildingStatusType {
  hard
  middle
  empty
}

model Buildings {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  index     Int
  name      String
  picture   String
  floors    Floor[]
  projects  Projects[]
  mapPins   MapPin[]
  statusHistory BuildingStatus[]
}

enum toilets {
  MAN
  WOMAN
  BOTH
}

model Floor {
  id          String      @id @default(uuid())
  createdAt   DateTime   @default(now())
  building    Buildings  @relation(fields: [building_id], references: [id])
  building_id String
  floor_num   Int
  floor_map_img String
  projects    Projects[]
  mapPins     MapPin[]
  toilets     toilets?
  status      BuildingStatusType?
}

model Projects {
  id          String     @id @default(uuid())
  createdAt   DateTime  @default(now())
  name        String
  picture     String
  description String
  floor       Floor     @relation(fields: [floor_id], references: [id])
  floor_id    String
  building    Buildings @relation(fields: [building_id], references: [id])
  building_id String
  room_name   String
  project_genre String

  foodPlaces  FoodPlace[]
  team_name   String
  mapPins     MapPin[]
  // スタンプ設置場所（任意の逆参照）
  stampPlaces StampPlace[]
  event_times event_time[]
}

enum PinType {
  Building
  Room
}

model MapPin {
  id          String     @id @default(uuid())
  createdAt   DateTime  @default(now())
  type        PinType
  x           Int
  y           Int
  
  // リレーション - タイプに応じて参照するIDが異なる
  building_id String?
  floor_id    String?
  project_id  String?
  
  // リレーション定義
  building    Buildings? @relation(fields: [building_id], references: [id])
  floor       Floor?     @relation(fields: [floor_id], references: [id])
  project     Projects?   @relation(fields: [project_id], references: [id])

}

model BuildingStatus {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now())
  status      BuildingStatusType
  building_id String
  building    Buildings      @relation(fields: [building_id], references: [id])
}

model Project_tag{
  id          String     @id @default(uuid())
  createdAt   DateTime  @default(now())
  tag         String
}

// フード提供場所を表すモデル
model FoodPlace {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  place       String
  
  // 紐づく企画（屋台など）
  project     Projects   @relation(fields: [project_id], references: [id])
  project_id  String
  foods       FoodData[]
}

model StampQuiz {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  quiz_data   String
  // 紐づくスタンプ設置場所
  stampPlaceId String
  stampPlace   StampPlace @relation(fields: [stampPlaceId], references: [id])
  random_key   String
}

model event_time {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  title       String
  start_time  String
  end_time    String
  project_id  String?
  project     Projects?   @relation(fields: [project_id], references: [id])
  event_space_id  String
  event_space    event_space   @relation(fields: [event_space_id], references: [id])
  event_date_id  String
  event_date    event_date   @relation(fields: [event_date_id], references: [id])
}

model event_date {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  index       Int
  name        String
  event_spaces event_time[]
}

model event_space {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  name        String
  color       String
  event_times event_time[]
  index       Int?
}

enum NotificationType {
  ALL
  PART
}

model notifications {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  title       String
  content     String
  link        String?
  status      NotificationType @default(ALL)
}

model SitePublicationState {
  id          String   @id @default("global")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isPublished Boolean  @default(true)
}