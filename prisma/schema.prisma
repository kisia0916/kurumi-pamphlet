generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum FoodStatus {
  AVAILABLE
  FEW
  SOLDOUT
}
enum FoodCategory {
  MAIN
  SUB
  DESSERT
}

enum ProjectGenre {
  SHOP
  STUDENT
  DISPLAY_CHEMISTRY
  DISPLAY_CULTURE
  PERFORMANCE
  MUSIC
  FOOD
  ACTIVITY
}

model FoodData {
  id         String    @id @default(uuid())
  createdAt  DateTime @default(now())
  name       String
  category   FoodCategory
  photo      String
  price      Int
  status     FoodStatus
  allergens  String[]
  food_place_id String
  food_pace       FoodPlace?     @relation(fields: [food_place_id], references: [id])
  food_index      Int?
}

model TimeTableContents {
  id        String    @id @default(uuid())
  createdAt DateTime @default(now())
  title     String
  place     String
  time      DateTime
  info      String
  photo     String
}

model StampPlace {
  id        String    @id @default(uuid())
  createdAt DateTime @default(now())
  title     String
  photo     String
  maplink   String
  place     String
}

model UserStamps {
  id         String    @id @default(uuid())
  createdAt  DateTime @default(now())
  userId     String
  stamps     String[]
  exchanged  Boolean
}

model User {
  id        String    @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
}

enum BuildingStatusType {
  hard
  middle
  empty
}

model Buildings {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  index     Int
  name      String
  picture   String
  floors    Floor[]
  projects  Projects[]
  mapPins   MapPin[]
  statusHistory BuildingStatus[]
}

model Floor {
  id          String      @id @default(uuid())
  createdAt   DateTime   @default(now())
  building    Buildings  @relation(fields: [building_id], references: [id])
  building_id String
  floor_num   Int
  floor_map_img String
  projects    Projects[]
  mapPins     MapPin[]
}

model Projects {
  id          String     @id @default(uuid())
  createdAt   DateTime  @default(now())
  name        String
  picture     String
  description String
  floor       Floor     @relation(fields: [floor_id], references: [id])
  floor_id    String
  building    Buildings @relation(fields: [building_id], references: [id])
  building_id String
  room_name   String
  project_genre String

  foodPlaces  FoodPlace[]
  team_name   String
  mapPins     MapPin[]
}

enum PinType {
  Building
  Room
}

model MapPin {
  id          String     @id @default(uuid())
  createdAt   DateTime  @default(now())
  type        PinType
  x           Int
  y           Int
  
  // リレーション - タイプに応じて参照するIDが異なる
  building_id String?
  floor_id    String?
  project_id  String?
  
  // リレーション定義
  building    Buildings? @relation(fields: [building_id], references: [id])
  floor       Floor?     @relation(fields: [floor_id], references: [id])
  project     Projects?   @relation(fields: [project_id], references: [id])

}

model BuildingStatus {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now())
  status      BuildingStatusType
  building_id String
  building    Buildings      @relation(fields: [building_id], references: [id])
}

model Project_tag{
  id          String     @id @default(uuid())
  createdAt   DateTime  @default(now())
  tag         String
}

// フード提供場所を表すモデル
model FoodPlace {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  place       String
  
  // 紐づく企画（屋台など）
  project     Projects   @relation(fields: [project_id], references: [id])
  project_id  String
  foods       FoodData[]
}
